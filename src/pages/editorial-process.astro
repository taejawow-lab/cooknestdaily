---
import BaseLayout from '../layouts/BaseLayout.astro';
const steps = [
  ['01','Topic selection','Choose a real household food-safety handoff such as cooling leftovers, packing a cooler, separating raw poultry, or cleaning a cutting board.'],
  ['02','Source collection','Collect official or primary references. FoodSafety.gov, USDA FSIS, FDA, and CDC are preferred for U.S. consumer food-safety topics.'],
  ['03','Drafting','Write the reader workflow: risk, measurement, tools, timing, discard rule, and exceptions for high-risk eaters.'],
  ['04','Source and link check','Verify that cited links resolve and that claims do not exceed the source. Broken or weak sources block publication.'],
  ['05','Content-depth review','Check for thin copy, repeated boilerplate, missing stop rules, missing internal links, or generic AI-like paragraphs.'],
  ['06','Image review','Use only relevant article images. Avoid meaningless placeholders, fake text, logos, hands/faces, and confusing UI-style visuals.'],
  ['07','Build and smoke test','Run the static build, open key pages, confirm indexable metadata, and check that post images load.'],
  ['08','Periodic recheck','Re-audit older articles for source freshness, repeated patterns, thin sections, and AdSense readiness before resubmission.']
];
---
<BaseLayout title="Editorial Process" description="How CookNest Daily reviews, improves, and publishes food-safety articles.">
  <article class="culinary-container py-16 md:py-24">
    <p class="section-kicker">Method · 8 checks</p>
    <h1 class="section-title mt-3">Editorial process</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">This process reflects the current CookNest Daily workflow after the June 2026 AdSense quality audit.</p>
    <div class="mt-12 space-y-6">
      {steps.map(([n,title,body]) => <section class="culinary-card grid gap-4 p-6 md:grid-cols-[110px_1fr]"><p class="text-5xl font-bold text-accent" style="font-family: var(--font-display);">{n}</p><div><h2 class="text-3xl font-semibold text-primary" style="font-family: var(--font-display);">{title}</h2><p class="mt-2 text-muted-foreground leading-7">{body}</p></div></section>)}
    </div>
  </article>
</BaseLayout>
