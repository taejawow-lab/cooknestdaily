---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const POSTS_PER_PAGE = 24;
const categorySlug = (category: string) => category.toLowerCase().trim().replace(/\s+/g, '-');
const posts = (await getCollection('posts')).filter((post)=>!post.data.draft).sort((a,b)=>b.data.pubDate.valueOf()-a.data.pubDate.valueOf());
const byCategory = posts.reduce((acc,post)=>{const cat=post.data.category||'general'; if(!acc[cat]) acc[cat]=[]; acc[cat].push(post); return acc;}, {} as Record<string, typeof posts>);
const categories = Object.keys(byCategory).sort();
const pagePosts = posts.slice(0, POSTS_PER_PAGE);
---
<BaseLayout title="Recipe & Safety Library" description={`CookNest Daily archive of ${posts.length} tested cooking and food-safety guides.`}>
  <section class="culinary-container py-16 md:py-24"><div class="grid gap-8 border-b border-border pb-12 md:grid-cols-[0.8fr_1.2fr] md:items-end"><div><p class="section-kicker">Recipe & Safety Library</p><h1 class="section-title mt-3">Article archive</h1><p class="mt-5 text-sm font-bold uppercase tracking-[0.15em] text-muted-foreground">{posts.length} guides · expert vetted cards</p></div><div><p class="text-lg leading-8 text-muted-foreground">Filter CookNest Daily by category and sort by freshness. Every card keeps the expert-vetted mark visible for cooking, cookware, and food-safety guidance.</p><div class="mt-5 flex flex-wrap gap-3"><a href="/tools/" class="btn-secondary">Tool scorecards</a><a href="/safety/" class="btn-secondary">Safety table</a></div></div></div><div class="mt-10 grid gap-8 lg:grid-cols-[280px_minmax(0,1fr)]"><aside class="culinary-card h-fit p-5 lg:sticky lg:top-32"><h2 class="m-0 text-2xl font-semibold text-primary" style="font-family: var(--font-display);">Filter Drawer</h2><label class="mt-5 block text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground" for="library-search">Search</label><input id="library-search" type="search" placeholder="Search meat, skillet, dinner..." class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 outline-none focus:border-primary"/><label class="mt-5 block text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground" for="library-sort">Sort by</label><select id="library-sort" class="mt-2 w-full rounded-lg border border-border bg-background px-3 py-2 outline-none focus:border-primary"><option value="newest">Newest first</option><option value="oldest">Oldest first</option><option value="az">Title A–Z</option></select><div class="mt-6"><p class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground">Categories</p><div class="mt-3 space-y-2">{categories.map((cat)=><label class="flex cursor-pointer items-center gap-2 rounded-lg border border-border/70 bg-background px-3 py-2 text-sm font-semibold text-muted-foreground"><input class="library-category" type="checkbox" value={cat.toLowerCase()} /><span>{cat} ({byCategory[cat].length})</span></label>)}</div></div><p id="library-count" class="mt-6 rounded-lg bg-primary/10 px-3 py-2 text-sm font-bold text-primary">Showing latest {pagePosts.length}</p></aside><div id="library-grid" class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">{pagePosts.map((post,i)=><ArticleCard title={post.data.title} description={post.data.description} href={`/posts/${post.slug}/`} image={post.data.heroImage} category={post.data.category} pubDate={post.data.pubDate} variant="standard" index={i}/>)}</div></div>{posts.length>POSTS_PER_PAGE && <div class="mt-12 rounded-xl border border-border bg-card p-5 text-sm text-muted-foreground">Showing the newest {POSTS_PER_PAGE} guides. Older pages remain available through numbered archive routes and category pages.</div>}<script is:inline>const search=document.getElementById('library-search');const sort=document.getElementById('library-sort');const checks=[...document.querySelectorAll('.library-category')];const grid=document.getElementById('library-grid');const cards=[...document.querySelectorAll('#library-grid > article')];const count=document.getElementById('library-count');function applyFilters(){const q=(search?.value||'').toLowerCase().trim();const cats=checks.filter(c=>c.checked).map(c=>c.value);let shown=cards.filter(card=>{const title=card.dataset.title||'';const cat=(card.dataset.category||'').toLowerCase();return(!q||title.includes(q))&&(!cats.length||cats.includes(cat));});shown.sort((a,b)=>{const mode=sort?.value||'newest';if(mode==='az')return(a.dataset.title||'').localeCompare(b.dataset.title||'');const da=new Date(a.dataset.date||0).getTime();const db=new Date(b.dataset.date||0).getTime();return mode==='oldest'?da-db:db-da;});cards.forEach(card=>card.style.display='none');shown.forEach(card=>{card.style.display='';grid?.appendChild(card);});if(count)count.textContent=`Showing ${shown.length} matching guides`;}[search,sort,...checks].forEach(el=>el?.addEventListener('input',applyFilters));checks.forEach(el=>el.addEventListener('change',applyFilters));</script></section>
</BaseLayout>
