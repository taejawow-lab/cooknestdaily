---
export interface Props { title: string; subtitle: string; illustration?: string; ctaText?: string; ctaHref?: string; }
const envIllustration = import.meta.env.PUBLIC_HAS_HERO_ILLUSTRATION === 'true' ? '/images/illustrations/hero.png' : undefined;
const edition = import.meta.env.PUBLIC_SITE_EDITION || 'CN · DAILY';
const { title, subtitle, illustration = envIllustration, ctaText = 'Open Safety Guides', ctaHref = '/posts/' } = Astro.props;
---
<section class="relative overflow-hidden border-b border-border/70 bg-background"><div class="absolute inset-0 opacity-[0.05]" aria-hidden="true" style="background-image: linear-gradient(to right, rgb(var(--color-primary)) 1px, transparent 1px), linear-gradient(to bottom, rgb(var(--color-primary)) 1px, transparent 1px); background-size: 56px 56px;"></div><div class="culinary-container relative grid gap-10 py-14 md:grid-cols-[1.05fr_0.8fr] md:items-center md:py-24"><div><div class="mb-8 flex flex-wrap items-center gap-3 text-[11px] font-bold uppercase tracking-[0.2em] text-muted-foreground"><span class="rounded-lg bg-primary/10 px-3 py-1 text-primary ring-1 ring-primary/20">{edition}</span><span class="h-px w-12 bg-border"></span><span>Food safety first</span></div><p class="section-kicker mb-4">Scientifically Verified · Kitchen Tested</p><h1 class="max-w-4xl text-5xl font-semibold leading-[0.98] tracking-[-0.03em] text-primary md:text-7xl lg:text-[5.9rem]" style="font-family: var(--font-display);">{title}</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-muted-foreground md:text-2xl md:leading-9">{subtitle}</p><div class="mt-9 flex flex-wrap items-center gap-4"><a href={ctaHref} class="btn-primary">{ctaText} →</a><a href="/tools/" class="btn-secondary">Compare tools</a><span class="safety-badge">Expert Vetted</span></div><div class="mt-10 grid max-w-2xl grid-cols-3 gap-3"><div class="culinary-card p-4"><strong class="block text-2xl text-primary">USDA</strong><span class="text-xs text-muted-foreground">source checks</span></div><div class="culinary-card p-4"><strong class="block text-2xl text-primary">30m</strong><span class="text-xs text-muted-foreground">time trials</span></div><div class="culinary-card p-4"><strong class="block text-2xl text-primary">Safe</strong><span class="text-xs text-muted-foreground">storage charts</span></div></div></div><div class="relative"><div class="absolute inset-4 rounded-[2rem] bg-primary/8 rotate-2" aria-hidden="true"></div><div class="culinary-card relative overflow-hidden rounded-[2rem] p-5">{illustration ? <img src={illustration} alt="" class="h-[22rem] w-full rounded-2xl object-cover md:h-[30rem]" loading="eager" /> : <div class="grid h-[26rem] place-items-center rounded-2xl bg-muted"><span class="text-8xl font-semibold text-primary/35">CN</span></div>}<div class="mt-5 rounded-2xl bg-primary p-5 text-primary-foreground"><p class="text-[11px] font-bold uppercase tracking-[0.18em] text-primary-foreground/65">Trust bar</p><p class="mt-2 text-lg font-semibold">Scientifically verified · kitchen tested</p><p class="mt-2 text-sm text-primary-foreground/75">Recipes and kitchen guides surface timing, safety notes, and practical test conditions.</p></div></div></div></div></section>
