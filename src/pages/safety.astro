---
import BaseLayout from '../layouts/BaseLayout.astro';
const rows = [
 {status:'Safe', cls:'status-safe', item:'Cooked leftovers', window:'Refrigerate within 2 hours; use within 3–4 days', note:'Label containers and cool quickly in shallow portions.'},
 {status:'Caution', cls:'status-caution', item:'Raw meat thawing', window:'Use refrigerator thawing when possible', note:'Avoid counter thawing; keep raw juices away from ready-to-eat food.'},
 {status:'Danger', cls:'status-danger', item:'Room-temperature perishable food', window:'Discard after extended time in danger zone', note:'When time/temperature history is unknown, do not taste-test.'},
];
---
<BaseLayout title="Food Safety Fact Check" description="CookNest Daily food-safety table pattern for safe, caution, and danger states."><section class="culinary-container py-16 md:py-24"><div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-end"><div><p class="section-kicker">Safety Certification System</p><h1 class="section-title mt-3">Food safety fact check</h1></div><p class="text-lg leading-8 text-muted-foreground">A responsive safety table pattern for storage, thawing, and cross-contamination guidance. It is designed for visibility inside articles and hub pages.</p></div><div class="culinary-card mt-10 overflow-hidden"><table class="w-full text-left"><thead class="bg-primary text-primary-foreground"><tr><th class="px-4 py-3">Status</th><th class="px-4 py-3">Kitchen item</th><th class="px-4 py-3">Timeline</th><th class="px-4 py-3">Fact check</th></tr></thead><tbody>{rows.map((row)=><tr class={row.cls}><td class="px-4 py-4 font-bold">{row.status}</td><td class="px-4 py-4">{row.item}</td><td class="px-4 py-4">{row.window}</td><td class="px-4 py-4 text-sm text-muted-foreground">{row.note}</td></tr>)}</tbody></table></div><aside class="culinary-card mt-8 p-6"><span class="safety-badge">Expert Vetted</span><h2 class="mt-4 text-3xl font-semibold text-primary" style="font-family: var(--font-display);">Safety warning module</h2><p class="mt-3 text-muted-foreground">Use this block for high-importance warnings in meat storage, leftovers, allergen separation, and tool-use articles. It keeps the warning clear without breaking the premium editorial tone.</p></aside></section></BaseLayout>
