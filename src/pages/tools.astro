---
import BaseLayout from '../layouts/BaseLayout.astro';
const tools = [
 {name:'Cast Iron Skillet', durability:9, heat:9, weight:5, note:'Excellent heat retention and durability, but weight and maintenance matter for small kitchens.'},
 {name:'Stainless Sauté Pan', durability:8, heat:7, weight:7, note:'Versatile for weeknight cooking and acidic sauces; requires better heat control.'},
 {name:'Nonstick Skillet', durability:5, heat:6, weight:9, note:'Fast cleanup and low-fat cooking, but coating wear and high-heat limits need attention.'},
 {name:'Sheet Pan', durability:7, heat:6, weight:8, note:'High utility for batch cooking; warping and rim height affect results.'},
];
---
<BaseLayout title="Kitchen Tool Review Scorecards" description="CookNest Daily standardized tool scorecards for durability, heat retention, weight, and cleanup."><section class="culinary-container py-16 md:py-24"><div class="grid gap-8 md:grid-cols-[0.85fr_1.15fr] md:items-end"><div><p class="section-kicker">Tool Comparison Engine</p><h1 class="section-title mt-3">Kitchen tool scorecards</h1></div><p class="text-lg leading-8 text-muted-foreground">A standardized review layout for cookware and kitchen tools. Scores are editorial UI examples that show how durability, heat retention, and weight can be compared without hype.</p></div><div class="mt-10 culinary-card p-5"><label class="text-xs font-bold uppercase tracking-[0.18em] text-muted-foreground" for="tool-search">Search tools</label><input id="tool-search" class="mt-3 w-full rounded-lg border border-border bg-background px-4 py-3 text-lg outline-none focus:border-primary" type="search" placeholder="Search skillet, pan, nonstick, sheet..." /></div><div id="tool-grid" class="mt-8 grid gap-5 md:grid-cols-2">{tools.map((tool)=><article class="culinary-card tool-card p-6" data-name={tool.name.toLowerCase()}><span class="kitchen-tested">Kitchen tested</span><h2 class="mt-4 text-3xl font-semibold text-primary" style="font-family: var(--font-display);">{tool.name}</h2>{[['Durability',tool.durability],['Heat retention',tool.heat],['Weight comfort',tool.weight]].map(([label,score])=><div class="mt-5"><div class="mb-2 flex justify-between text-sm font-bold"><span>{label}</span><span>{score}/10</span></div><div class="score-bar"><span style={`width:${Number(score)*10}%`}></span></div></div>)}<p class="mt-5 text-sm leading-7 text-muted-foreground">{tool.note}</p></article>)}</div><script is:inline>const input=document.getElementById('tool-search');const cards=[...document.querySelectorAll('.tool-card')];input?.addEventListener('input',()=>{const q=input.value.toLowerCase().trim();cards.forEach(c=>c.style.display=!q||c.dataset.name.includes(q)?'':'none')});</script></section></BaseLayout>
