---
import BaseLayout from '../layouts/BaseLayout.astro';
const siteName = import.meta.env.PUBLIC_SITE_NAME || 'CookNestDaily';
const siteDescription = import.meta.env.PUBLIC_SITE_DESCRIPTION || 'Practical food-safety and weeknight cooking guides built around official sources and kitchen checklists.';
---
<BaseLayout title="About" description={`About ${siteName}: practical food-safety and kitchen workflow guidance.`}>
  <article class="culinary-container py-16 md:py-24">
    <p class="section-kicker">About · CookNest Daily</p>
    <h1 class="section-title mt-3">Practical food-safety guidance for everyday kitchens</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">{siteDescription}</p>

    <section class="mt-12 grid gap-6 md:grid-cols-3">
      <div class="culinary-card p-6"><span class="safety-badge">Mission</span><h2 class="mt-4 text-3xl font-semibold text-primary" style="font-family: var(--font-display);">Make safety actionable</h2><p class="mt-3 text-muted-foreground">We turn official food-safety guidance into household workflows: what to measure, what to separate, what to label, and when to discard.</p></div>
      <div class="culinary-card p-6"><span class="safety-badge">Sources</span><h2 class="mt-4 text-3xl font-semibold text-primary" style="font-family: var(--font-display);">Official first</h2><p class="mt-3 text-muted-foreground">Core references come from FoodSafety.gov, USDA FSIS, FDA, CDC, cooperative extensions, and other primary or standards-based sources.</p></div>
      <div class="culinary-card p-6"><span class="safety-badge">Limits</span><h2 class="mt-4 text-3xl font-semibold text-primary" style="font-family: var(--font-display);">No diagnosis</h2><p class="mt-3 text-muted-foreground">We do not diagnose illness or replace medical, public-health, or local regulatory guidance. High-risk situations should use professional advice.</p></div>
    </section>

    <section class="mt-14 max-w-4xl space-y-6 text-[17px] leading-8 text-foreground/80">
      <h2 class="text-4xl font-semibold text-primary" style="font-family: var(--font-display);">What makes a CookNest Daily article useful</h2>
      <p>Every guide is written for a specific kitchen handoff: shopping to storage, raw prep to cooked serving, cooking to cooling, refrigerator to lunch bag, or appliance to cleanup. We avoid vague advice such as “be careful” unless it is attached to a measurable action.</p>
      <p>Our preferred article format includes a risk table, a practical checklist, official-source links, a discard or stop rule, and reminders for higher-risk eaters. When a topic has uncertainty, we say so rather than pretending that a home kitchen can verify everything by smell, color, or taste.</p>
      <p>Corrections and source updates can be requested by email: <a class="underline underline-offset-4 decoration-accent" href="mailto:editor@cooknestdaily.org">editor@cooknestdaily.org</a>.</p>
    </section>
  </article>
</BaseLayout>
