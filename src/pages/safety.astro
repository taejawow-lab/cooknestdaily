---
import BaseLayout from '../layouts/BaseLayout.astro';
const rows = [
 {status:'Safe default', cls:'status-safe', item:'Cold holding', window:'Keep the refrigerator at 40°F / 4°C or below', note:'Use an appliance thermometer; do not rely on how cold the shelf feels.'},
 {status:'Safe default', cls:'status-safe', item:'Cooked leftovers', window:'Refrigerate promptly in shallow containers', note:'Label date and food name; reheat thoroughly before serving.'},
 {status:'Caution', cls:'status-caution', item:'Raw meat prep', window:'Separate boards, plates, and utensils', note:'Do not return cooked food to a raw-meat platter.'},
 {status:'Caution', cls:'status-caution', item:'Outdoor serving', window:'Write a serving start time', note:'Use smaller portions and refill from controlled hot/cold storage.'},
 {status:'Danger', cls:'status-danger', item:'Unknown time/temperature history', window:'Discard instead of taste-testing', note:'Smell, color, and texture are not reliable safety tests.'},
];
---
<BaseLayout title="Food Safety Fact Check" description="CookNest Daily quick-reference food-safety table for home kitchens.">
  <section class="culinary-container py-16 md:py-24">
    <p class="section-kicker">Safety quick reference</p>
    <h1 class="section-title mt-3">Food safety fact check</h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted-foreground">Use this page as a quick companion to the article library. It is not a complete rulebook; follow the linked official sources and local guidance for special situations.</p>
    <div class="culinary-card mt-10 overflow-hidden"><table class="w-full text-left"><thead class="bg-primary text-primary-foreground"><tr><th class="px-4 py-3">Status</th><th class="px-4 py-3">Kitchen item</th><th class="px-4 py-3">Control</th><th class="px-4 py-3">Fact check</th></tr></thead><tbody>{rows.map((row)=><tr class={row.cls}><td class="px-4 py-4 font-bold">{row.status}</td><td class="px-4 py-4">{row.item}</td><td class="px-4 py-4">{row.window}</td><td class="px-4 py-4 text-sm text-muted-foreground">{row.note}</td></tr>)}</tbody></table></div>
    <div class="mt-8 grid gap-6 md:grid-cols-3"><a class="culinary-card p-6" href="https://www.foodsafety.gov/keep-food-safe/4-steps-to-food-safety"><span class="safety-badge">Official</span><h2 class="mt-4 text-2xl font-semibold text-primary">FoodSafety.gov 4 Steps</h2><p class="mt-2 text-sm text-muted-foreground">Clean, separate, cook, and chill.</p></a><a class="culinary-card p-6" href="https://www.fsis.usda.gov/food-safety"><span class="safety-badge">Official</span><h2 class="mt-4 text-2xl font-semibold text-primary">USDA FSIS</h2><p class="mt-2 text-sm text-muted-foreground">Meat, poultry, leftovers, danger zone, and refrigeration guidance.</p></a><a class="culinary-card p-6" href="https://www.fda.gov/food/buy-store-serve-safe-food/safe-food-handling"><span class="safety-badge">Official</span><h2 class="mt-4 text-2xl font-semibold text-primary">FDA Safe Food Handling</h2><p class="mt-2 text-sm text-muted-foreground">Shopping, storage, preparation, and serving reminders.</p></a></div>
  </section>
</BaseLayout>
